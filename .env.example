# Copy to `.env` and fill in. Anything not set falls back to defaults in config/settings.py.

# --- Source ---
PLAYSTORE_APP_ID=com.nextbillion.groww
WEEKS_LOOKBACK=12              # minimum 12, allowed up to 26
LANG=en
COUNTRY=in

# --- LLM (Phase 3+) ---
GROQ_API_KEY=
GROQ_MODEL_REASONING=llama-3.1-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
PHASE3_MAX_ROWS=1200           # cap reviews for Groq classification under TPM limits
PHASE3_BATCH_SIZE=8
PHASE3_SAMPLE_SIZE=40

# --- Email (Phase 5) ---
EMAIL_MODE=draft               # draft | send | both
# Verified From address (Resend/SMTP). Not supplied by the frontend.
EMAIL_FROM=noreply@your-verified-domain.com
# Optional default To for CLI/cron when --recipient is omitted (UI passes recipient per request).
ALERT_EMAIL=you@example.com
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# For Gmail, SMTP_USER defaults to the address in EMAIL_FROM if omitted.
SMTP_USER=
SMTP_PASS=
# Alias for SMTP_PASS (same value):
EMAIL_PASSWORD=

# --- Vercel runtime (Phase 6, auto-injected on deploy) ---
BLOB_READ_WRITE_TOKEN=
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
CRON_SECRET=

# --- Local dev ---
RUN_LOCAL=1                    # 1 = use filesystem; 0 = use Vercel Blob/KV
LOG_LEVEL=INFO
